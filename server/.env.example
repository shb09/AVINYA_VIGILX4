# SENTINEL — server configuration.
# All vars are prefixed with SENTINEL_. Loaded by pydantic-settings from server/.env.

# --- server ---
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8100

# --- browser ---
# true = headless (servers/CI); false = headed (watch the live browser)
SENTINEL_BROWSER_HEADLESS=true
SENTINEL_VIEWPORT_WIDTH=1360
SENTINEL_VIEWPORT_HEIGHT=840
SENTINEL_NAV_TIMEOUT_MS=20000
SENTINEL_SHOT_INTERVAL_MS=320
SENTINEL_SHOT_QUALITY=70
# Where Playwright browser binaries live (installed by server/scripts/install_browsers.py)
# SENTINEL_BROWSER_BINARIES_DIR=./.browsers

# --- persistence ---
SENTINEL_DATA_DIR=./data
# SENTINEL_AUDIT_DIR=./data/audit
# SENTINEL_DB_PATH=./data/sentinel.db

# --- planner ---
# auto = use SENTINEL_OPENAI_API_KEY if set, otherwise the deterministic LOCAL PLANNER
SENTINEL_PLANNER_PROVIDER=auto
SENTINEL_OPENAI_MODEL=gpt-4o-mini
SENTINEL_OPENAI_BASE_URL=https://api.openai.com/v1
# SENTINEL_OPENAI_API_KEY=

# --- security ---
SENTINEL_APPROVAL_TTL_SECONDS=120
SENTINEL_AGENT_MAX_STEPS=8
SENTINEL_MAX_SESSION_EVENTS=1500
SENTINEL_MAX_AUDIT_LINES_PER_FILE=5000

# Optional canary seed. If empty/unset, the server generates one per process.
# SENTINEL_CANARY_SEED=SENTINEL_CANARY_ABC123

# Playwright browsers path (alternative to SENTINEL_BROWSER_BINARIES_DIR, also read by playwright)
# PLAYWRIGHT_BROWSERS_PATH=./.browsers